      }]
    },

    {
      "id": 13,
      "title": "Uptime por Esclavo (s)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "colorMode": "value" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "rawQuery": true, "refId": "A",
