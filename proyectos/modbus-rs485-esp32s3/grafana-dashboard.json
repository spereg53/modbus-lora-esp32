    {
      "id": 9,
      "type": "row",
      "title": "🖥 Estado ESP32-C3",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 6,
      "title": "Temperatura CPU (°C)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 80 }
          ]}
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "rawQuery": true, "refId": "A",
        "alias": "Slave [[tag_slave_id]]",
        "query": "SELECT mean(\"temp_c\") FROM \"esp32_c3\" WHERE $timeFilter GROUP BY time($__interval), \"slave_id\" fill(null)"
      }]
    },

    {
      "id": 7,
      "title": "RSSI WiFi (dBm)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "rawQuery": true, "refId": "A",
        "alias": "Slave [[tag_slave_id]]",
        "query": "SELECT mean(\"rssi_dbm\") FROM \"esp32_c3\" WHERE $timeFilter GROUP BY time($__interval), \"slave_id\" fill(null)"
      }]
    },

    {
      "id": 8,
      "title": "Free Heap (bytes)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
