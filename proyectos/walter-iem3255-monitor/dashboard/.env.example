# Copiar a .env y completar. NUNCA subir .env al repo.

PORT=3001

MQTT_URL=mqtts://mqtt.ocean53.xyz:8883
MQTT_USERNAME=sergio
MQTT_PASSWORD=

MQTT_TOPIC=iem3255/walter01/state
# Topic de diagnóstico del firmware (Modbus/red/MQTT). Por defecto se deriva
# de MQTT_TOPIC reemplazando "/state" por "/diag"; sólo hace falta fijarlo
# aquí si se usa un topic de estado que no termina en "/state".
# MQTT_TOPIC_DIAG=iem3255/walter01/diag

# Cuántas lecturas recientes mantener en memoria para las gráficas "en vivo"
# (independiente del histórico persistente en SQLite)
LIVE_BUFFER_LENGTH=120

# Retención del histórico en la base de datos SQLite (días). Con una lectura
# cada 5 min, 180 días son ~52,000 filas (~4MB) — sobra en un droplet de 1GB.
HISTORY_RETENTION_DAYS=180

# Ruta del archivo SQLite (se crea solo si no existe)
DB_PATH=./data/iem3255.db
